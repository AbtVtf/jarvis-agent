#!/usr/bin/env bash
# Jarvis launcher: ollama + server + desktop widget.
# Usage: ./jarvis [start|stop|status]
set -u
ROOT="$(cd "$(dirname "$0")" && pwd)"
OLLAMA="$ROOT/build/ollama/bin/ollama"
LOG="$ROOT/build"

status() {
  curl -s http://127.0.0.1:11434/api/tags >/dev/null 2>&1 \
    && echo "ollama:  running" || echo "ollama:  stopped"
  curl -s http://127.0.0.1:8710/api/agents >/dev/null 2>&1 \
    && echo "server:  running (http://127.0.0.1:8710)" || echo "server:  stopped"
  pgrep -f "jarvis-widget|electron \." >/dev/null && echo "widget:  running" \
    || echo "widget:  stopped"
}

stop_all() {
  pkill -f "[u]vicorn server.main" 2>/dev/null
  pkill -f "widget/node_modules/[e]lectron/dist/electron" 2>/dev/null
  pkill -f "node_modules/.bin/[e]lectron . --no-sandbox" 2>/dev/null
  echo "stopped server and widget (ollama left running; kill manually if wanted)"
}

start_all() {
  if ! curl -s http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    echo "starting ollama..."
    (OLLAMA_KEEP_ALIVE=-1 "$OLLAMA" serve > "$LOG/ollama-serve.log" 2>&1 &)
    sleep 3
  fi
  if ! curl -s http://127.0.0.1:8710/api/agents >/dev/null 2>&1; then
    echo "starting jarvis server (models take ~60-90s to load)..."
    ( cd "$ROOT" && nohup .venv/bin/uvicorn server.main:app \
        --host 127.0.0.1 --port 8710 > "$LOG/server.log" 2>&1 < /dev/null & )
    for _ in $(seq 1 60); do
      sleep 3
      curl -s http://127.0.0.1:8710/api/agents >/dev/null 2>&1 && break
    done
  fi
  if ! pgrep -f "widget/node_modules/[e]lectron/dist/electron" >/dev/null; then
    echo "starting widget..."
    ( cd "$ROOT/widget" && \
      nohup "$ROOT/widget/node_modules/electron/dist/electron" . --no-sandbox \
        > "$LOG/widget.log" 2>&1 < /dev/null & )
  fi
  echo "jarvis is up — say 'hey jarvis', press Ctrl+Shift+J, or open http://127.0.0.1:8710"
}

case "${1:-start}" in
  start) start_all ;;
  stop) stop_all ;;
  status) status ;;
  *) echo "usage: ./jarvis [start|stop|status]"; exit 1 ;;
esac
